{
  "name": "Pastey",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "macos": "npx react-native run-macos --mode Debug",
    "macos:release": "react-native run-macos --mode Release",
    "build:release": "bash scripts/build-release.sh",
    "macos:pods": "cd macos && pod install",
    "macos:xcode": "open macos/Pastey.xcworkspace",
    "lint": "eslint .",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "postinstall": "patch-package",
    "test": "jest"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^18.2.5",
    "@shopify/flash-list": "^1.7.1",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-macos": "^0.76.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.3",
    "@react-native/eslint-config": "0.76.3",
    "@react-native/metro-config": "0.76.3",
    "@react-native/typescript-config": "0.76.3",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "op-sqlite": {
    "sqliteOptions": {
      "fts5": true
    }
  }
}
